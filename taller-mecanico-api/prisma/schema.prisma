// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generado/prisma"
}

datasource db {
  provider = "mysql"
}

model Cliente{
  id Int @id @default(autoincrement())
  nombre String @db.VarChar(150)
  telefono String @db.VarChar(15)
  correo String @unique @db.VarChar(150)
  vehiculos Vehiculo[]

  @@map("clientes")
}

model Vehiculo{
  id Int @id @default(autoincrement())
  clienteId Int
  placa String @unique @db.VarChar(20)
  marca String @db.VarChar(50)
  modelo String @db.VarChar(50)
  anio Int

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  ordenes OrdenServicio[]

  @@index([clienteId])
  @@map("vehiculos")
}

enum EstadoOrden {
  abierta
  en_proceso
  entregada
  cancelada
}

model OrdenServicio {
  id Int @id @default(autoincrement())
  vehiculoId Int
  descripcion String @db.VarChar(255)
  fechaIngreso DateTime
  estado EstadoOrden

  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)
  refacciones Refaccion[]

  @@index([vehiculoId])
  @@map("ordenes_servicio")
}

model Refaccion{
  id Int @id @default(autoincrement())
  ordenId Int
  nombre String @db.VarChar(150)
  precio Decimal 

  ordeneServicio OrdenServicio @relation(fields: [ordenId], references:[id], onDelete: Cascade)

  @@map("refacciones")
}